# VouchWire Backend — Environment Variables
# Copy this file to .env and adjust values for your environment.

NODE_ENV=development
PORT=4000

# Docker: mongodb://mongodb:27017/vouchwire?replicaSet=rs0
# Native (local dev only): mongodb://localhost:27017/vouchwire?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://localhost:27017/vouchwire?replicaSet=rs0&directConnection=true
MONGODB_REPLICA_SET=rs0

LOG_LEVEL=info

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of proxies to trust (0 = none)
TRUST_PROXY=0

# Maximum JSON body size
API_BODY_LIMIT=256kb

# Note: Local .env files should never be tracked in git.
# JWT and Authentication
JWT_ACCESS_SECRET=your_32_character_minimum_access_secret_here
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=vouchwire
JWT_AUDIENCE=vouchwire-client
REFRESH_COOKIE_NAME=vw_refresh
